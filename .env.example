# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-this-to-a-long-random-string-in-production
DATABASE_URL=postgresql://postgres:password@localhost:5432/authorcraft_sts

# Scoring (whole-number increments; default 0-10)
SCORING_MIN=0
SCORING_MAX=10
SCORING_STEP=1

# Voting window length in seconds (server-enforced)
VOTING_DURATION_SECONDS=10
